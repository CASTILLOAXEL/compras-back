<?php

namespace Database\Seeders;

use App\Models\Permission;
use App\Models\Role;
use Illuminate\Database\Seeder;
use Spatie\Permission\PermissionRegistrar;

/**
 * Permisos del CRUD de {{ nombrePermiso }} (generado con generar:crud).
 *
 * Para ejecutar: php artisan db:seed --class={{ modelo }}PermisosSeeder
 */
class {{ modelo }}PermisosSeeder extends Seeder
{
    public function run(): void
    {
        app(PermissionRegistrar::class)->forgetCachedPermissions();

        $permisos = [
            'ver {{ nombrePermiso }}',
            'crear {{ nombrePermiso }}',
            'editar {{ nombrePermiso }}',
            'eliminar {{ nombrePermiso }}',
        ];

        foreach ($permisos as $permiso) {
            Permission::firstOrCreate([
                'name' => $permiso,
                'subject' => '{{ modelo }}',
                'guard_name' => 'api',
            ]);
        }

        Role::findByName(Role::SUPER_ADMINISTRADOR, 'api')->givePermissionTo($permisos);
        Role::findByName(Role::ADMINISTRADOR, 'api')->givePermissionTo($permisos);
    }
}
